# Environment
NODE_ENV=development
APP_ENV=local

# Firebase Configuration
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id","private_key_id":"your-key-id","private_key":"your-private-key","client_email":"your-service-account@iam.gserviceaccount.com","client_id":"your-client-id","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"your-cert-url"}

# Server Configuration
PORT=3000
JSON_BODY_LIMIT=1mb
REQUEST_TIMEOUT_MS=120000

# Gemini API Configuration
# Using gemini-2.5-flash (free tier available, no billing required)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta

# CORS Configuration
# FRONTEND_URL is kept for backward compatibility
FRONTEND_URL=https://your-app-name.vercel.app
CORS_ALLOWED_ORIGINS=https://your-app-name.vercel.app,https://www.your-domain.com
CORS_ALLOWED_ORIGIN_PATTERNS=https://your-preview-app-*.vercel.app
DEV_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Shared KV (Redis) for distributed rate-limiting/cache (required in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Upload Security
MAX_UPLOAD_BYTES=52428800
UPLOAD_RETENTION_MS=86400000
MAX_ANALYZE_FILE_BYTES=52428800

# Chat and payload validation
MAX_MESSAGE_LENGTH=4000
MAX_FILES_CONTEXT=5
MAX_FILE_NAME_LENGTH=200
MAX_FILE_CONTENT_LENGTH=12000
MAX_HISTORY_ITEMS=40
MAX_HISTORY_MESSAGE_LENGTH=4000

# Rate limiting
GLOBAL_RATE_WINDOW_MS=60000
GLOBAL_RATE_USER_MAX=160
GLOBAL_RATE_IP_MAX=300
ANALYZE_RATE_WINDOW_MS=60000
ANALYZE_RATE_USER_MAX=20
ANALYZE_RATE_IP_MAX=40
CHAT_RATE_WINDOW_MS=60000
CHAT_RATE_USER_MAX=80
CHAT_RATE_IP_MAX=120
